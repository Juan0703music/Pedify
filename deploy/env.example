# Pedify — configuración del servidor (docker compose).
# En el servidor:  cp deploy/env.example .env  &&  chmod 600 .env
# Nunca subas el .env al repositorio. Guía: docs/deployment.md
#
# Genera cada secreto con:  openssl rand -hex 24

# ─── Entorno ────────────────────────────────────────────────
# production: el servicio real · staging: entorno de pruebas (otro servidor y otro dominio).
APP_ENV=production
# Dominio sin https:// (su registro DNS A debe apuntar a la IP de este servidor).
DOMAIN=pedifyai.com

# ─── Base de datos ──────────────────────────────────────────
# Solo letras y números (va dentro de la URL de conexión): openssl rand -hex 24
POSTGRES_PASSWORD=

# ─── Fotos (almacenamiento externo, sección 13 del documento) ─
# Recomendado: Cloudflare R2 (sin costo por descarga). local = disco del servidor (volumen uploads).
STORAGE_DRIVER=s3
S3_BUCKET=pedifyai-fotos
S3_REGION=auto
# R2: https://<id-de-cuenta>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dirección pública del bucket (dominio propio o r2.dev), sin "/" final. Ej.: https://fotos.pedifyai.com
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ─── Correo (recuperación de contraseña) ────────────────────
# Cualquier proveedor SMTP. Ej.: smtps://usuario:clave@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM=Pedify <no-responder@pedifyai.com>

# ─── Comercialización y monitoreo ───────────────────────────
# WhatsApp del equipo para pagos de planes y soporte (57XXXXXXXXXX).
SUPPORT_WHATSAPP=
# Token para /metrics (Prometheus): openssl rand -hex 24
METRICS_TOKEN=
LOG_LEVEL=info

# ─── Copias de seguridad ────────────────────────────────────
# Días de copias que se guardan en el servidor.
BACKUP_KEEP_DAYS=14
# Copia externa (muy recomendado): descomenta COMPOSE_PROFILES y completa los datos del bucket.
# Usa un bucket distinto al de las fotos y una llave que solo pueda escribir en él.
# COMPOSE_PROFILES=offsite
OFFSITE_PROVIDER=Cloudflare
OFFSITE_ENDPOINT=
OFFSITE_REGION=auto
OFFSITE_BUCKET=pedifyai-copias
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=

# ─── Solo en el entorno de pruebas (APP_ENV=staging) ────────
# Contraseña de la cuenta demo@pedifyai.com que crea `docker compose run --rm tools npm run db:seed`.
DEMO_PASSWORD=
