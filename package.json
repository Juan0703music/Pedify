{
  "name": "pedifyai",
  "version": "0.1.0",
  "private": true,
  "description": "Pedify — plataforma SaaS de pedidos digitales para negocios de comida rápida.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,css -c blue,magenta \"npm:dev:api\" \"npm:dev:css\"",
    "dev:api": "tsx watch --clear-screen=false src/server.ts",
    "dev:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --watch",
    "build": "npm run build:css && npm run build:api",
    "build:css": "tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "build:api": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "tsx scripts/dev-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "admin:grant": "tsx scripts/admin.ts grant",
    "admin:revoke": "tsx scripts/admin.ts revoke",
    "db:backup": "tsx scripts/backup.ts create",
    "db:backup:verify": "tsx scripts/backup.ts verify",
    "db:restore": "tsx scripts/backup.ts restore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "lucide-static": "^1.57.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "argon2@0.45.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.5.1": true
  }
}
