{
  "id": "/admin",
  "name": "Pedify Admin",
  "short_name": "Pedify Admin",
  "description": "El panel central de Pedify: pagos de los planes por revisar, negocios, ingresos y analíticas.",
  "lang": "es-CO",
  "dir": "ltr",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "background_color": "#17161c",
  "theme_color": "#17161c",
  "categories": ["business", "productivity"],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Pagos por revisar", "short_name": "Pagos", "url": "/admin#pagos", "icons": [{ "src": "/assets/icons/shortcut-orders-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Analíticas", "short_name": "Analíticas", "url": "/admin#analiticas", "icons": [{ "src": "/assets/icons/shortcut-home-96.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
