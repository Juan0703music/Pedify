// Pedify — modelo de datos multiempresa (multi-tenant).
// Cada negocio tiene sus propios productos, categorías, clientes, pedidos y configuración.
// Los nombres de tabla siguen el documento de arquitectura (sección 5).
// Dinero: enteros en pesos colombianos (COP), sin decimales.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enumeraciones ───────────────────────────────

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  EMPLOYEE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
  DINE_IN // para comer en el local: el cliente pide desde su mesa escaneando el QR
}

// Planes de Pedify (el detalle de precios y límites está en src/modules/subscriptions/plans.ts).
enum PlanCode {
  EMPRENDEDOR
  NEGOCIO
  EMPRESA
}

// Estado de un pago del plan en línea: los mismos de las transacciones de Wompi.
enum PlanCheckoutStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

/// Cobro del domicilio: un valor fijo o según la distancia hasta el cliente.
enum DeliveryPricing {
  FIXED
  DISTANCE
}

// Qué pedidos cuentan como venta en las analíticas (sección 11 del documento).
enum SalesPolicy {
  ACCEPTED // desde que el negocio acepta el pedido (confirmado en adelante)
  DELIVERED // solo pedidos entregados
  PAID // solo pedidos marcados como pagados
}

enum PaymentMethod {
  CASH
  NEQUI
  DAVIPLATA
  BANK_TRANSFER
  CARD
  /// Llave Bre-B (celular, correo, cédula o alias): se paga desde cualquier banco o billetera.
  BRE_B
}

// ───────────────────────────── Cuentas y negocios ────────────────────────────

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  name              String
  email             String    @unique
  passwordHash      String    @map("password_hash")
  // Administra la plataforma (panel central de Pedify). Solo se asigna por consola.
  isPlatformAdmin   Boolean   @default(false) @map("is_platform_admin")
  // Autorización del tratamiento de datos personales (Ley 1581 de 2012) al registrarse.
  privacyAcceptedAt DateTime? @map("privacy_accepted_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         BusinessMembership[]
  sessions            Session[]
  statusChanges       OrderStatusHistory[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
  recordedPayments    SubscriptionPayment[]
  planCheckouts       PlanCheckout[]
  planTransfers       PlanTransfer[]        @relation("PlanTransferCreatedBy")
  reviewedTransfers   PlanTransfer[]        @relation("PlanTransferReviewedBy")

  @@map("users")
}

// Sesiones del panel: el token viaja en una cookie httpOnly y aquí solo se guarda su hash.
// Permite revocar sesiones (cerrar sesión, cerrar todas, cambio de contraseña).
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  activeBusinessId String?   @map("active_business_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Recuperación de contraseña: enlace de un solo uso; aquí solo se guarda el hash del token.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Business {
  id              String         @id @default(uuid(7)) @db.Uuid
  name            String
  // Identificador público para la tienda (pedifyai.com/tienda/<slug>). No reemplaza al id interno.
  slug            String         @unique
  phone           String
  status          BusinessStatus @default(ACTIVE)
  description     String?
  city            String?
  address         String?
  // Imágenes de la tienda: URL pública y clave en el almacenamiento (para reemplazarlas o borrarlas).
  logoUrl         String?        @map("logo_url")
  logoKey         String?        @map("logo_key")
  bannerUrl       String?        @map("banner_url")
  bannerKey       String?        @map("banner_key")
  // Consecutivo de pedidos del negocio (Pedido #1, #2, …). Se incrementa dentro de la transacción del pedido.
  lastOrderNumber Int            @default(0) @map("last_order_number")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships       BusinessMembership[]
  settings          BusinessSettings?
  subscription      Subscription?
  pushSubscriptions PushSubscription[]
  courierTrackings  CourierTracking[]
  paymentAccounts   PaymentAccount[]
  paymentProofs     PaymentProof[]
  payments          SubscriptionPayment[]
  planCheckouts     PlanCheckout[]
  planTransfers     PlanTransfer[]
  categories        Category[]
  products          Product[]
  customers         Customer[]
  orders            Order[]

  @@map("businesses")
}

model BusinessMembership {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  role       MembershipRole
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Permisos de un empleado; los elige el propietario en Configuración → Equipo.
  /// El propietario siempre puede todo (estas columnas no se usan para él).
  canMarkSoldOut   Boolean @default(true) @map("can_mark_sold_out")
  canViewSales     Boolean @default(true) @map("can_view_sales")
  canViewCustomers Boolean @default(true) @map("can_view_customers")
  canViewAnalytics Boolean @default(false) @map("can_view_analytics")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_memberships")
}

model BusinessSettings {
  businessId         String          @id @map("business_id") @db.Uuid
  // Horario semanal: [{ day: 0-6 (0 = domingo), closed, open: "HH:MM", close: "HH:MM" }]
  openingHours       Json            @map("opening_hours")
  timezone           String          @default("America/Bogota")
  // Interruptor manual para pausar la recepción de pedidos.
  acceptingOrders    Boolean         @default(true) @map("accepting_orders")
  // Número de WhatsApp que recibe los pedidos (celular). Null hasta que el comerciante lo configure.
  whatsappPhone      String?         @map("whatsapp_phone")
  deliveryEnabled    Boolean         @default(true) @map("delivery_enabled")
  // Cómo se cobra el domicilio: tarifa fija (deliveryFee) o según la distancia (deliveryTiers).
  deliveryPricing    DeliveryPricing @default(FIXED) @map("delivery_pricing")
  deliveryFee        Int             @default(0) @map("delivery_fee")
  // Tarifas por distancia en línea recta desde el negocio: [{ upToKm, fee }] de menor a mayor.
  deliveryTiers      Json            @default("[]") @map("delivery_tiers")
  // Más allá del último rango: valor por cada km adicional (null = no se lleva más lejos).
  deliveryExtraKmFee Int?            @map("delivery_extra_km_fee")
  // Distancia máxima del domicilio en km (null = toda la ciudad, hasta el tope de Pedify).
  deliveryMaxKm      Float?          @map("delivery_max_km")
  // Ubicación del negocio (punto de partida para medir la distancia del domicilio).
  locationLat        Float?          @map("location_lat")
  locationLng        Float?          @map("location_lng")
  deliveryArea       String?         @map("delivery_area")
  pickupEnabled      Boolean         @default(true) @map("pickup_enabled")
  // Pedidos desde la mesa: el cliente escanea el QR del local y pide para comer ahí.
  dineInEnabled      Boolean         @default(true) @map("dine_in_enabled")
  minimumOrder       Int             @default(0) @map("minimum_order")
  paymentMethods     PaymentMethod[] @default([CASH]) @map("payment_methods")
  salesPolicy        SalesPolicy     @default(ACCEPTED) @map("sales_policy")
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

// ─────────────────────────────── Suscripciones ───────────────────────────────

// Suscripción del negocio a Pedify. El estado (prueba, activa, vencida) se calcula con las fechas:
// pagado hasta `paid_until`; si no, prueba hasta `trial_ends_at`; luego unos días de gracia.
model Subscription {
  businessId  String    @id @map("business_id") @db.Uuid
  plan        PlanCode  @default(NEGOCIO)
  trialEndsAt DateTime  @map("trial_ends_at") @db.Timestamptz(3)
  paidUntil   DateTime? @map("paid_until") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// Pagos de la suscripción: registrados por el equipo de Pedify (transferencia, Nequi…) o pagados
// en línea con Wompi (method WOMPI, sin recorded_by).
model SubscriptionPayment {
  id           String   @id @default(uuid(7)) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  plan         PlanCode
  amount       Int
  months       Int
  method       String
  reference    String?
  note         String?
  periodStart  DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd    DateTime @map("period_end") @db.Timestamptz(3)
  recordedById String?  @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recordedBy User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  checkout   PlanCheckout?
  transfer   PlanTransfer?

  @@index([businessId, createdAt])
  @@map("subscription_payments")
}

// Pago del plan en línea con Wompi. Se crea al ir a pagar (su id es la referencia del pago en Wompi)
// y se completa con el aviso de Wompi o al volver a Pedify; si se aprueba, queda unido al pago registrado.
model PlanCheckout {
  id            String             @id @default(uuid(7)) @db.Uuid
  businessId    String             @map("business_id") @db.Uuid
  plan          PlanCode
  months        Int
  // Valor en pesos (a Wompi va en centavos).
  amount        Int
  status        PlanCheckoutStatus @default(PENDING)
  // Última transacción de Wompi con esta referencia y su medio de pago (CARD, NEQUI, PSE…).
  transactionId String?            @map("transaction_id")
  paymentMethod String?            @map("payment_method")
  paymentId     String?            @unique @map("payment_id") @db.Uuid
  createdById   String?            @map("created_by_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment   SubscriptionPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("plan_checkouts")
}

// ───────────────────────────────── Catálogo ──────────────────────────────────

model Category {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId, position])
  @@map("categories")
}

model Product {
  id          String    @id @default(uuid(7)) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  name        String
  description String?
  price       Int
  // Foto del producto: URL pública y clave en el almacenamiento compatible con S3.
  imageUrl    String?   @map("image_url")
  imageKey    String?   @map("image_key")
  // Visible en la tienda (activar / desactivar).
  isActive    Boolean   @default(true) @map("is_active")
  // Disponible para pedir; false = agotado.
  isAvailable Boolean   @default(true) @map("is_available")
  position    Int       @default(0)
  // Los productos que aparecen en pedidos históricos se archivan en lugar de eliminarse.
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@unique([id, businessId])
  @@index([businessId, categoryId, position])
  @@map("products")
}

// ─────────────────────────────── Clientes ────────────────────────────────────

model Customer {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  phone      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]

  @@unique([businessId, phone])
  @@unique([id, businessId])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  address    String
  references String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// ──────────────────────────────── Pedidos ────────────────────────────────────

model Order {
  id                String         @id @default(uuid(7)) @db.Uuid
  businessId        String         @map("business_id") @db.Uuid
  customerId        String         @map("customer_id") @db.Uuid
  number            Int
  status            OrderStatus    @default(PENDING)
  deliveryType      DeliveryType   @map("delivery_type")
  // Copia de los datos del cliente al momento del pedido.
  customerName      String         @map("customer_name")
  customerPhone     String         @map("customer_phone")
  deliveryAddress   String?        @map("delivery_address")
  addressReferences String?        @map("address_references")
  /// Mesa del cliente cuando come en el local (la del QR que escaneó o la que escribió).
  tableNumber       String?        @map("table_number")
  notes             String?
  paymentMethod     PaymentMethod? @map("payment_method")
  // Valores calculados en el backend, nunca tomados del navegador.
  subtotal          Int
  deliveryFee       Int            @default(0) @map("delivery_fee")
  discount          Int            @default(0)
  total             Int
  // Evita pedidos duplicados cuando el navegador reintenta la solicitud.
  idempotencyKey    String?        @map("idempotency_key")
  // Momento en que el cliente abrió WhatsApp con el mensaje (no garantiza que lo haya enviado).
  whatsappOpenedAt  DateTime?      @map("whatsapp_opened_at") @db.Timestamptz(3)
  // Pago recibido (lo marca el negocio). Se distingue de aceptado y entregado.
  paidAt            DateTime?      @map("paid_at") @db.Timestamptz(3)
  /// Punto exacto de entrega que marcó el cliente con su GPS (opcional, solo domicilios).
  /// Se borra cuando el pedido se entrega o se cancela (minimización de datos personales).
  deliveryLat       Float?         @map("delivery_lat")
  deliveryLng       Float?         @map("delivery_lng")
  /// Distancia en línea recta del negocio al punto de entrega, en metros (con la que se cobró el domicilio).
  deliveryDistanceM Int?           @map("delivery_distance_m")
  cancelReason      String?        @map("cancel_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Clave foránea compuesta: el cliente debe pertenecer al mismo negocio que el pedido.
  customer      Customer             @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  courier       CourierTracking?
  paymentProof  PaymentProof?

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@unique([id, businessId])
  @@index([businessId, status, createdAt])
  @@index([businessId, createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(uuid(7)) @db.Uuid
  businessId  String @map("business_id") @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  // Copia del nombre y precio para conservar el valor histórico.
  productName String @map("product_name")
  unitPrice   Int    @map("unit_price")
  quantity    Int
  subtotal    Int

  // Claves foráneas compuestas: impiden que un pedido incluya productos de otro negocio.
  order   Order   @relation(fields: [orderId, businessId], references: [id, businessId], onDelete: Cascade)
  product Product @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([orderId])
  @@index([businessId, productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Dispositivos que reciben notificaciones push de pedidos nuevos (Web Push con llaves VAPID).
/// Una suscripción pertenece a una persona y al negocio que tenía activo al activarla.
model PushSubscription {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  /// URL del servicio de push del navegador (Google, Mozilla, Apple o Microsoft).
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSentAt DateTime? @map("last_sent_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@map("push_subscriptions")
}

/// Seguimiento del domiciliario de un pedido a domicilio. El negocio genera un enlace secreto
/// (solo se guarda su hash) y el domiciliario comparte desde él su ubicación sin cuenta.
/// Solo se guarda la última posición, y la fila se borra al entregar o cancelar el pedido.
model CourierTracking {
  orderId    String    @id @map("order_id") @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  lat        Float?
  lng        Float?
  /// Precisión del GPS en metros.
  accuracy   Int?
  heading    Float?
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)

  order    Order    @relation(fields: [orderId, businessId], references: [id, businessId], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([orderId, businessId])
  @@index([businessId])
  @@map("courier_tracking")
}

enum PaymentAccountKind {
  NEQUI
  BRE_B
  DAVIPLATA
}

/// Cuentas para cobrar por transferencia: el QR que el negocio sacó de su app (Nequi, Bre-B de su
/// banco o Daviplata) y su número o llave. El cliente las ve al pedir (paga antes de enviar el
/// pedido) y el domiciliario las muestra al entregar.
model PaymentAccount {
  id         String             @id @default(uuid(7)) @db.Uuid
  businessId String             @map("business_id") @db.Uuid
  kind       PaymentAccountKind
  /// Número de celular o llave Bre-B (celular, correo, cédula o alias con @).
  accountKey String?            @map("account_key")
  holderName String?            @map("holder_name")
  /// Contenido del código QR leído de la imagen subida (se vuelve a dibujar nítido para escanearlo).
  qrPayload  String?            @map("qr_payload")
  qrImageUrl String?            @map("qr_image_url")
  qrImageKey String?            @map("qr_image_key")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, kind])
  @@map("payment_accounts")
}

/// Comprobante del pago por transferencia que el cliente sube antes de enviar su pedido. Se sube
/// primero (sin pedido) y queda unido al pedido al crearlo; los que nunca se usan se borran al día.
/// La imagen es privada: solo el equipo del negocio la ve, a través de la API.
model PaymentProof {
  id          String           @id @default(uuid(7)) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  orderId     String?          @map("order_id") @db.Uuid
  imageKey    String           @map("image_key")
  /// Huella del archivo (SHA-256) para reconocer un comprobante que ya se usó en otro pedido.
  imageHash   String?          @map("image_hash")
  /// Texto leído del comprobante (OCR) y cuándo terminó la lectura (null = leyendo o no se pudo).
  receiptText String?          @map("receipt_text")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  /// Referencia o número de aprobación leído (para detectar el mismo pago en dos pedidos).
  reference   String?
  /// Resultado de la verificación automática y el detalle de cada revisión.
  checkStatus ProofCheckStatus @default(PENDING) @map("check_status")
  checks      Json             @default("[]")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([orderId, businessId])
  @@index([businessId, createdAt])
  @@index([businessId, reference])
  @@map("payment_proofs")
}

/// Verificación automática del comprobante: leyendo, todo coincide, hay que revisarlo o algo no coincide.
enum ProofCheckStatus {
  PENDING
  VERIFIED
  REVIEW
  MISMATCH
}

/// Cuentas de Pedify para recibir el pago de los planes por transferencia directa (Nequi y llave Bre-B).
/// Las configura un administrador en /admin y los propietarios las ven en «Mi plan».
model PlatformPaymentAccount {
  kind       PaymentAccountKind @id
  /// Número de celular o llave Bre-B (celular, correo, cédula o alias con @).
  accountKey String?            @map("account_key")
  holderName String?            @map("holder_name")
  /// Contenido del código QR leído de la imagen subida (se vuelve a dibujar nítido para escanearlo).
  qrPayload  String?            @map("qr_payload")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_payment_accounts")
}

/// Pago directo del plan: en revisión, aprobado (el plan se extendió) o rechazado.
enum PlanTransferStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pago de un plan por transferencia directa a las cuentas de Pedify (Nequi o llave Bre-B): el
/// propietario sube el comprobante, Pedify lo lee y lo revisa, y un administrador lo aprueba o lo rechaza.
model PlanTransfer {
  id           String             @id @default(uuid(7)) @db.Uuid
  businessId   String             @map("business_id") @db.Uuid
  plan         PlanCode
  months       Int
  amount       Int
  method       PaymentAccountKind
  status       PlanTransferStatus @default(PENDING)
  /// Imagen privada del comprobante y su huella (SHA-256) para reconocer el mismo pantallazo dos veces.
  imageKey     String             @map("image_key")
  imageHash    String?            @map("image_hash")
  /// Texto leído del comprobante (OCR), cuándo terminó la lectura y la referencia leída.
  receiptText  String?            @map("receipt_text")
  readAt       DateTime?          @map("read_at") @db.Timestamptz(3)
  reference    String?
  checkStatus  ProofCheckStatus   @default(PENDING) @map("check_status")
  checks       Json               @default("[]")
  rejectReason String?            @map("reject_reason")
  createdById  String?            @map("created_by_id") @db.Uuid
  reviewedById String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  paymentId    String?            @unique @map("payment_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment    SubscriptionPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy  User?                @relation("PlanTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User?                @relation("PlanTransferReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([businessId, createdAt])
  @@index([reference])
  @@index([imageHash])
  @@map("plan_transfers")
}
