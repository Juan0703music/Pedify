# ─── Servidor ───────────────────────────────────────────────
NODE_ENV=development
# Solo con NODE_ENV=production: production (servicio real) o staging (entorno de pruebas).
# En el servidor se usa deploy/env.example (ver docs/deployment.md).
APP_ENV=production
PORT=3000
# URL pública de la aplicación (se usa para enlaces de la tienda y CORS).
APP_URL=http://localhost:3000
# Orígenes adicionales permitidos por CORS, separados por comas.
CORS_ORIGINS=
# Número de proxies delante de la app (1 detrás de Nginx/Caddy/Railway). 0 en local.
TRUST_PROXY=0
LOG_LEVEL=info

# ─── Base de datos ──────────────────────────────────────────
# En local, `npm run db:start` levanta PostgreSQL embebido en el puerto 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pedifyai

# ─── Sesiones ───────────────────────────────────────────────
# Días de vida de la sesión (se renueva con el uso).
SESSION_TTL_DAYS=7
# true en producción (HTTPS). En local con http debe ser false.
COOKIE_SECURE=false

# ─── Imágenes (fotos de productos, logo y portada) ──────────
# local: se guardan en UPLOADS_DIR y se sirven en /uploads (desarrollo o un solo servidor).
# s3: almacenamiento compatible con S3 (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# Solo con STORAGE_DRIVER=s3:
S3_BUCKET=
S3_REGION=us-east-1
# Vacío para AWS; p. ej. https://<cuenta>.r2.cloudflarestorage.com para R2.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública del bucket o CDN, sin "/" final (p. ej. https://imagenes.pedifyai.com).
S3_PUBLIC_URL=
# true para MinIO u otros servicios que usan rutas en lugar de subdominios.
S3_FORCE_PATH_STYLE=false

# ─── Correo ─────────────────────────────────────────────────
# Recuperación de contraseña. Ej.: smtps://usuario:clave@smtp.proveedor.com:465
# Sin SMTP_URL, en desarrollo el enlace aparece en el registro del servidor; en producción no se envía.
SMTP_URL=
MAIL_FROM=Pedify <no-responder@pedifyai.com>

# ─── Comercialización y monitoreo ───────────────────────────
# WhatsApp del equipo de Pedify para pagos de planes y soporte (57XXXXXXXXXX).
SUPPORT_WHATSAPP=
# Notificaciones push de pedidos nuevos (celular o computador del negocio, aunque el panel esté cerrado).
# Genera las dos llaves con `npm run push:keys`. Vacías = sin avisos push. La privada es un secreto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (mailto:… o https://…). Vacío = el correo de MAIL_FROM.
VAPID_SUBJECT=
# Token para consultar /metrics (Prometheus). Vacío = métricas desactivadas.
METRICS_TOKEN=
